{
  "name": "code-foundry",
  "version": "0.19.0",
  "description": "A fast, language-aware repository factory for agent-ready workflows, testing, security, and release automation.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPlayerOne/code-foundry.git"
  },
  "homepage": "https://github.com/0xPlayerOne/code-foundry#readme",
  "bugs": {
    "url": "https://github.com/0xPlayerOne/code-foundry/issues"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "code-foundry": "src/cli.mjs"
  },
  "files": [
    "src",
    ".github",
    ".githooks",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    "CHANGELOG.md",
    "release-please-config.json",
    ".mise.toml",
    ".prettierrc",
    ".env.example",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "ruff.toml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --check src/cli.mjs",
    "format:check": "node --check src/cli.mjs",
    "lint": "node --check src/cli.mjs",
    "test": "node --check src/cli.mjs",
    "type-check": "node --check src/cli.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "publishConfig": {
    "access": "public"
  }
}
