{
  "name": "code-foundry",
  "version": "1.5.3",
  "description": "A fast, language-aware repository factory for agent-ready workflows, testing, security, and release automation.",
  "homepage": "https://github.com/0xPlayerOne/code-foundry#readme",
  "bugs": {
    "url": "https://github.com/0xPlayerOne/code-foundry/issues"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPlayerOne/code-foundry.git"
  },
  "bin": {
    "code-foundry": "src/cli.mjs"
  },
  "files": [
    "src",
    "docs",
    ".github",
    ".githooks",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    "CHANGELOG.md",
    "release-please-config.json",
    "ruff.toml",
    ".mise.toml",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    ".env.example",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --check src/cli.mjs",
    "format:check": "oxfmt --check .",
    "fmt": "oxfmt .",
    "lint": "oxlint",
    "test": "node --test",
    "test:unit": "node --test",
    "type-check": "tsc --project jsconfig.json",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.0"
}
