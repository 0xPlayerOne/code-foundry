#!/usr/bin/env sh
# Generated by Code Foundry — see src/commands/sync.mjs.
#
# This used to run `git diff --cached --check` and nothing else, even though
# the language-aware gate already existed in the runtime (preCommit()). Every
# consumer therefore committed ungated and found formatting, lint, and type
# errors on CI instead. Keep this a thin launcher: the checks belong to the
# runtime so they stay consistent with the CI tasks.
#
# `--no-verify` remains the escape hatch. The fallback keeps the whitespace
# guard working offline rather than failing a commit because npx is
# unavailable.
set -eu

if [ -z "$(git diff --cached --name-only)" ]; then
  exit 0
fi

if command -v npx >/dev/null 2>&1 && npx --yes code-foundry@latest pre-commit; then
  exit 0
fi

git diff --cached --check
